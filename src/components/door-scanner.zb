<!--
  The door: a ticket's code in, and a big answer out. Scanning is a 'use server' function, so a
  ticket is let in once however many doors scan it at the same moment: the server decides.

  The code comes typed, or from a photo of the ticket (on a phone, the photo picker opens the
  camera; the page decodes the QR code with symbology and sends it here). Without JavaScript the
  form posts and the page shows the answer (`result-now`).
-->
<script>
  import { from } from '@zubra/runtime'

  let shown = from(resultNow)

  export async function scan(formData, context) {
    'use server'
    if (!context.staff) return { error: 'Sign in to scan tickets.' }
    return context.boxOffice.scan(formData.get('ticket'))
  }

  const at = (ms) => new Date(ms).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone })
  const admit = shown.admit ?? null
  const seats = admit ? admit.seats : []
  const answered = (event) => {
    shown = event.detail.value ?? { error: event.detail.error ? 'That didn’t go through. Try again.' : '' }
    event.currentTarget.reset()
  }
</script>
<style>
  :host { display: grid; gap: 1.25rem; }
  form { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; }
  label { display: grid; gap: 0.35rem; flex: 1 1 14rem; font-weight: 600; }
  input { font: inherit; padding: 0.65rem 0.8rem; border-radius: 0.5rem; border: 1px solid var(--border, #333847); background: var(--background, #14161b); color: inherit; }
  button { font: inherit; font-weight: 700; padding: 0.7rem 1.2rem; border: 0; border-radius: 0.5rem; background: var(--accent, #ffd166); color: #1a1c22; cursor: pointer; }
  .answer { display: grid; gap: 0.35rem; padding: 1.25rem 1.4rem; border-radius: 0.75rem; }
  .answer p { margin: 0; }
  .answer strong { font-size: clamp(2rem, 8vw, 3.25rem); line-height: 1; letter-spacing: 0.02em; }
  .admit { background: #12452b; color: #d8f5e3; }
  .refuse { background: #5a1d24; color: #ffd9dc; }
</style>
<door-scanner result-now={{}} time-zone="America/New_York">
  <form action={scan} onaction={answered}>
    <label>Ticket code <input name="ticket" autocomplete="off" spellcheck="false" required></label>
    <button type="submit">Check ticket</button>
  </form>
  <section class="answer admit" zb-if={shown.ok} role="status">
    <strong>Admit {seats.length}</strong>
    <p>{admit.film} · {at(admit.starts)} · {admit.hall}</p>
    <p>{seats.length === 1 ? 'Seat' : 'Seats'} {seats.join(', ')}</p>
  </section>
  <section class="answer refuse" zb-if={shown.error} role="alert">
    <strong>{shown.error}</strong>
    <p zb-if={shown.used}>First used at {at(shown.used)}{admit ? ` · ${admit.film}, ${admit.hall}, ${seats.join(', ')}` : ''}</p>
  </section>
</door-scanner>
