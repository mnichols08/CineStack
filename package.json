{
  "name": "cinestack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A movie theatre platform: showtimes, seats, snacks and tickets, run by the theatre's own manager. Built with Zubra on one small Node server.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@journey-to-code/symbology": "0.2.0",
    "@potomac-solutions/kit": "github:Potomac-Solutions/kit#41d3587e7b8c85088c834896e8983a955a8a0c64",
    "@zubra/actions": "5.13.1",
    "@zubra/compiler": "5.13.1",
    "@zubra/runtime": "5.13.1",
    "@zubra/server": "5.13.1",
    "@zubra/sync": "5.13.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
